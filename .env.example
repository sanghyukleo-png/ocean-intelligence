# OCEAN INTELLIGENCE — 환경변수 (지시서 11.2)
# .env.local(로컬) 또는 Vercel 프로젝트 환경변수에 넣는다. 키 값은 저장소에 커밋하지 않는다.
# 키가 없는 소스는 수집하지 않고 화면에 "API 키 미설정"으로 표시한다(숨기지 않음). 상태는 /status.

# ── 수집 저장소 ───────────────────────────────────────────────
# 없으면 서버 메모리(임시)에 저장 — 인스턴스가 바뀌면 이력이 사라진다.
# Supabase 프로젝트 → Settings → API: Project URL, secret key(서버 전용, 구형 이름 service_role).
# 스키마: supabase/migrations/0001_ingest.sql
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── 스케줄러 인증 ─────────────────────────────────────────────
# /api/ingest/[source] 호출 시 Authorization: Bearer <값>. 운영에서 비어 있으면 엔드포인트를 열지 않는다.
# Vercel cron은 이 이름의 변수를 자동으로 헤더에 넣는다. 외부 스케줄러 예시: supabase/cron.example.sql
CRON_SECRET=

# ── 원유 Brent·WTI ────────────────────────────────────────────
# EIA Open Data — https://www.eia.gov/opendata/ (이메일로 즉시 발급)
EIA_API_KEY=

# ── USD/KRW (우선순위: 수출입은행 → 한국은행 → ECB 기준환율[키 불필요]) ──
# 한국수출입은행 Open API — https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2&viewtype=C (일 1,000회)
KOREAEXIM_API_KEY=
# 한국은행 ECOS — https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# ── 기상청 ────────────────────────────────────────────────────
# 공공데이터포털 data.go.kr — 「기상청_기상특보 조회서비스」(15000415)·「기상청_중기예보 조회서비스」(15059468) 활용신청(자동승인)
# 마이페이지의 일반 인증키(Decoding)를 넣는다.
KMA_DATA_GO_KR_KEY=
# 기상청 API허브 — https://apihub.kma.go.kr/ (휴대폰 인증 가입) · 단기 해상예보·태풍. 명세 확인 후 연결 예정
KMA_APIHUB_KEY=

# ── AIS ───────────────────────────────────────────────────────
# aisstream.io — https://aisstream.io/ (GitHub 로그인 후 키 생성). 서버에서만 사용(브라우저 직접 연결 금지)
AISSTREAM_API_KEY=
# 수집 창(초). 기본 40 — 함수 최대 실행 시간(60초) 안에서
AIS_WINDOW_SEC=

# ── 시험용 ────────────────────────────────────────────────────
# 쉼표로 소스 id를 적으면 그 소스를 일부러 실패시킨다(마지막 성공값·실패 표시 확인용, 11.7). 예: frankfurter-ecb
INGEST_SIMULATE_FAILURE=

# ── AI (Phase 6) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
